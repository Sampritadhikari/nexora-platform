# Application Configuration
APP_ENV=development
PROJECT_NAME="Nexora Cloud Infrastructure"
VERSION=1.0.0

# Security & Tokens
JWT_SECRET=nexora_production_grade_jwt_secret_change_this_in_production_2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL primary)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nexora
SQLITE_FALLBACK_URL=sqlite:///./nexora.db

# Provider Configuration (mock for local dev, real credentials for production)
DOMAIN_PROVIDER=mock
HOSTING_PROVIDER=mock
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=mock

# Real Provider API Keys & Secrets (populated when switching away from mock)
DOMAIN_PROVIDER_API_KEY=
DOMAIN_PROVIDER_API_SECRET=
HOSTING_PROVIDER_API_KEY=
HOSTING_PROVIDER_API_SECRET=
PAYMENT_PROVIDER_KEY_ID=
PAYMENT_PROVIDER_KEY_SECRET=
EMAIL_PROVIDER_API_KEY=

# Public Frontend URL & CORS
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
TAX_RATE_PERCENT=18.0
DEFAULT_CURRENCY=INR
